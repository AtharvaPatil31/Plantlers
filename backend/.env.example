# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/plantlers?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Web Client ID from Google Cloud Console (same one in strings.xml)
GOOGLE_CLIENT_ID=325199277423-anbbs0sp8gs01pduumr5ptljdj784dd9.apps.googleusercontent.com

# ── Email (for OTP / forgot password) ────────────────────────────────────────
# Use Gmail App Password: Google Account → Security → 2FA → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Plantlers <your_gmail@gmail.com>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your Flutter app's origin if needed (for web)
ALLOWED_ORIGINS=http://localhost:3000
