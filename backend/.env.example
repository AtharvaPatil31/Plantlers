# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/plantlers

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/plantlers?retryWrites=true&w=majority

DB_NAME=plantlers

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from Google Cloud Console → OAuth 2.0 → Web Client ID
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email (for OTP / forgot password) ────────────────────────────────────────
# To use Gmail:
# 1. Go to: https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Search for "App passwords" → Create → Copy the 16-character password
# 4. Paste it as EMAIL_PASS below (not your regular Gmail password)
EMAIL_FROM=Plantlers <noreply@plantlers.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_character_app_password

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your Flutter app's origin if needed (for web)
CORS_ORIGIN=http://localhost:3000
